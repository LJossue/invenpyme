# Copie este archivo como .env y complete los valores.

# Cadena de conexion de PostgreSQL.
# En local:  postgresql://postgres:postgres@127.0.0.1:5432/invenpyme
# En Neon:   la que entrega el panel, con ?sslmode=require al final
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/invenpyme

# Clave con la que se firman las cookies de sesion.
# Genere una cadena larga y aleatoria. NO use este valor de ejemplo en produccion.
SESSION_SECRET=cambie-este-valor-por-una-cadena-larga-y-aleatoria

# Dejar en production cuando se despliegue en el servidor publico.
NODE_ENV=development

# Render asigna el puerto automaticamente. En local se usa el 8080.
PORT=8080
